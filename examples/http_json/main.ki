mod main

import http
import json

type Msg {
  status:str
}

fn app(req:http.Req) -> R[http.Resp,str] {
  when (req.path) {
  "/health" => {
  let body = json.encode ( value : Msg { status : "ok" } ) ?
  return Ok ( value : http.json ( code : 200 , body : body ) )
  }
  _ => {
  return Ok ( value : http.text ( code : 404 , body : "not found" ) )
  }
  }
}

fn main() -> i32 !net {
  http.serve ( addr : ":8080" , handler : app ) ?
  return 0
}

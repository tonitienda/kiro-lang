mod main

import env

const DefaultPort = ":8080"

type AppConfig {
  port:str
  env:str
}

fn load_config() -> R[AppConfig,str] !env {
  let port = env.get_or ( key : "PORT" , fallback : DefaultPort )
  let app_env = env.get_or ( key : "APP_ENV" , fallback : "dev" )
  return Ok ( value : AppConfig { port : port env : app_env } )
}

fn main() -> R[i32,str] !env !io {
  let cfg = load_config ( ) ?
  println ( value : "starting ${cfg.port} (${cfg.env})" )
  return Ok ( value : 0 )
}

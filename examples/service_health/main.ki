mod main

import http
import log

fn app(req:http.Req) -> R[http.Resp,str] {
  when (req.path) {
  "/health" => {
  return Ok ( value : http.text ( code : 200 , body : "ok" ) )
  }
  _ => {
  return Ok ( value : http.not_found ( ) )
  }
  }
}

fn main() -> i32 !log !net {
  log.info ( message : "starting :8080" )
  http.serve ( addr : ":8080" , handler : app ) ?
  return 0
}

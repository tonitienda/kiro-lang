mod main

import http

fn app(req:http.Req) -> R[http.Resp,str] {
  let resp = http.text ( code : 200 , body : "ok" )
  let resp2 = http.with_header ( resp : resp , key : "x-app" , value : "kiro" )
  return Ok ( value : resp2 )
}

fn main() -> R[i32,str] !net {
  http.serve ( addr : ":8080" , handler : app ) ?
  return Ok ( value : 0 )
}

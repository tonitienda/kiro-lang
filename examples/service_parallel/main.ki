mod main

import http
import json

type Msg {
  a:str
  b:str
}

fn slow_a() -> str {
  return "A"
}

fn slow_b() -> str {
  return "B"
}

fn app(req:http.Req) -> R[http.Resp,str] {
  when ( req.path ) {
  "/parallel" => {
  group {
  let ta = spawn slow_a ( )
  let tb = spawn slow_b ( )
  let a = await ta
  let b = await tb
  let body = json.encode ( value : Msg { a : a b : b } ) ?
  return Ok ( value : http.json ( code : 200 , body : body ) )
  }
  }
  _ => {
  return Ok ( value : http.not_found ( ) )
  }
  }
}

fn main() -> R[i32,str] !net {
  http.serve ( addr : ":8080" , handler : app ) ?
  return Ok ( value : 0 )
}

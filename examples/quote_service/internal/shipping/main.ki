mod shipping

type Error {
  variant UnknownDelivery {
    delivery:str
  }
  variant UnknownCoupon {
    coupon:str
  }
}

fn base_price(delivery:str) -> R[i32,Error] {
  when ( delivery ) {
  "standard" => {
  return Ok ( value : 300 )
  }
  "express" => {
  return Ok ( value : 800 )
  }
  _ => {
  return Err ( error : Error.UnknownDelivery ( delivery : delivery ) )
  }
  }
}

fn price(delivery:str, coupon:?str) -> R[i32,Error] {
  let base = base_price ( delivery : delivery ) ?
  when ( coupon ) {
  nil => {
  return Ok ( value : base )
  }
  "SHIPFREE" => {
  return Ok ( value : 0 )
  }
  _ => {
  return Err ( error : Error.UnknownCoupon ( coupon : coupon ) )
  }
  }
}

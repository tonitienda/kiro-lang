mod shipping

fn base_price(delivery:str) -> R[i32,str] {
  when ( delivery ) {
  "standard" => {
  return Ok ( 300 )
  }
  "express" => {
  return Ok ( 800 )
  }
  _ => {
  return Err ( "unknown delivery method" )
  }
  }
}

fn price(delivery:str, coupon:?str) -> R[i32,str] {
  let base = base_price ( delivery ) ?
  when ( coupon ) {
  nil => {
  return Ok ( base )
  }
  "SHIPFREE" => {
  return Ok ( 0 )
  }
  _ => {
  return Err ( "unknown coupon" )
  }
  }
}

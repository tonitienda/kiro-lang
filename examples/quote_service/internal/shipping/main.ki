mod shipping

fn base_price(delivery:str) -> R[i32,str] {
  when ( delivery ) {
  "standard" => {
  return Ok ( value : 300 )
  }
  "express" => {
  return Ok ( value : 800 )
  }
  _ => {
  return Err ( error : "unknown delivery method" )
  }
  }
}

fn price(delivery:str, coupon:?str) -> R[i32,str] {
  let base = base_price ( delivery : delivery ) ?
  when ( coupon ) {
  nil => {
  return Ok ( value : base )
  }
  "SHIPFREE" => {
  return Ok ( value : 0 )
  }
  _ => {
  return Err ( error : "unknown coupon" )
  }
  }
}

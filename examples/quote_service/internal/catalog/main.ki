mod catalog

type Error {
  variant UnknownProduct {
    sku:str
  }
}

fn price(sku:str) -> R[i32,Error] {
  when ( sku ) {
  "book" => {
  return Ok ( value : 1500 )
  }
  "poster" => {
  return Ok ( value : 700 )
  }
  _ => {
  return Err ( error : Error.UnknownProduct ( sku : sku ) )
  }
  }
}

fn addon_price(sku:?str) -> R[i32,Error] {
  when ( sku ) {
  nil => {
  return Ok ( value : 0 )
  }
  _ => {
  return price ( sku : sku )
  }
  }
}

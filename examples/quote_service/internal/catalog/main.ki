mod catalog

fn price(sku:str) -> R[i32,str] {
  when ( sku ) {
  "book" => {
  return Ok ( value : 1500 )
  }
  "poster" => {
  return Ok ( value : 700 )
  }
  _ => {
  return Err ( error : "unknown product" )
  }
  }
}

fn addon_price(sku:?str) -> R[i32,str] {
  when ( sku ) {
  nil => {
  return Ok ( value : 0 )
  }
  _ => {
  return price ( sku : sku )
  }
  }
}

mod catalog

fn price(sku:str) -> R[i32,str] {
  when ( sku ) {
  "book" => {
  return Ok ( 1500 )
  }
  "poster" => {
  return Ok ( 700 )
  }
  _ => {
  return Err ( "unknown product" )
  }
  }
}

fn addon_price(sku:?str) -> R[i32,str] {
  when ( sku ) {
  nil => {
  return Ok ( 0 )
  }
  _ => {
  return price ( sku )
  }
  }
}

mod app

import http
import json
import pricing

type QuoteRequest {
  sku:str
  addon:?str
  delivery:str
  coupon:?str
}

fn create_quote(req:http.Req) -> R[http.Resp,str] {
  let input = json.decode [ QuoteRequest ] ( req.body ) ?
  let quote = pricing.quote ( input.sku , input.addon , input.delivery , input.coupon ) ?
  let body = json.encode ( quote ) ?
  return Ok ( http.json ( 200 , body ) )
}

fn handler(req:http.Req) -> R[http.Resp,str] {
  when req.path
  "/health" => {
  when req.method
  "GET" => {
  return Ok ( http.text ( 200 , "ok" ) )
  }
  _ => {
  return Ok ( http.text ( 405 , "method not allowed" ) )
  }
  }
  "/quotes" => {
  when req.method
  "POST" => {
  return create_quote ( req )
  }
  _ => {
  return Ok ( http.text ( 405 , "method not allowed" ) )
  }
  }
  _ => {
  return Ok ( http.not_found ( ) )
  }
}

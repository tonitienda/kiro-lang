mod app

import http
import json
import pricing

type QuoteRequest {
  sku:str
  addon:?str
  delivery:str
  coupon:?str
}

fn create_quote(req:http.Req) -> R[http.Resp,str] {
  let input = json.decode [ QuoteRequest ] ( text : req.body ) ?
  let quote = pricing.quote ( sku : input.sku , addon : input.addon , delivery : input.delivery , coupon : input.coupon ) ?
  let body = json.encode ( value : quote ) ?
  return Ok ( value : http.json ( code : 200 , body : body ) )
}

fn handler(req:http.Req) -> R[http.Resp,str] {
  when ( req.path ) {
  "/health" => {
  when ( req.method ) {
  "GET" => {
  return Ok ( value : http.text ( code : 200 , body : "ok" ) )
  }
  _ => {
  return Ok ( value : http.text ( code : 405 , body : "method not allowed" ) )
  }
  }
  }
  "/quotes" => {
  when ( req.method ) {
  "POST" => {
  return create_quote ( req : req )
  }
  _ => {
  return Ok ( value : http.text ( code : 405 , body : "method not allowed" ) )
  }
  }
  }
  _ => {
  return Ok ( value : http.not_found ( ) )
  }
  }
}

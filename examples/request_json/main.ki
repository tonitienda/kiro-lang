mod main

import http
import json

type CreateReq {
  name:str
}

fn app(req:http.Req) -> R[http.Resp,str] {
  when (req.path) {
  "/items" => {
  let input = json.decode [ CreateReq ] ( text : req.body ) ?
  return Ok ( value : http.json ( code : 200 , body : json.encode ( value : input ) ? ) )
  }
  _ => {
  return Ok ( value : http.not_found ( ) )
  }
  }
}

mod main

import http

fn app(req:http.Req) -> R[http.Resp,str] {
  let name = http.query ( req : req , key : "name" )
  when (name) {
  nil => {
  return Ok ( value : http.text ( code : 200 , body : "hello stranger" ) )
  }
  _ => {
  return Ok ( value : http.text ( code : 200 , body : "hello" ) )
  }
  }
}

fn main() -> i32 !net {
  http.serve ( addr : ":8080" , handler : app ) ?
  return 0
}

mod main

type Resp {
  code:i32
  body:str
}

fn text(code:i32, body:str) -> Resp {
  return Resp { code : code body : body }
}

fn route(path:str) -> Resp {
  when ( path ) {
  "/health" => {
  return text ( code : 200 , body : "ok" )
  }
  _ => {
  return text ( code : 404 , body : "not found" )
  }
  }
}

fn main() -> i32 !io {
  let res = route ( path : "/health" )
  print ( value : res.body )
  return 0
}

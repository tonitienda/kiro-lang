mod main

fn main() -> i32 !io {
  mut total = 0
  for n in [ 1 , 2 , 3 ] {
  if n == 2 {
  continue
  }
  total = total + n
  }
  while total < 10 {
  total = total + 1
  if total == 8 {
  break
  }
  }
  when (total) {
  8 => {
  println ( value : "ok" )
  }
  _ => {
  println ( value : "other" )
  }
  }
  defer println ( value : "done" )
  return 0
}

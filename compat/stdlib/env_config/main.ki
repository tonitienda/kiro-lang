mod main

import env

type Config {
  addr:str
  mode:?str
}

fn load() -> R[Config,str] !env {
  let addr = env.get_or ( key : "ADDR" , fallback : ":8080" )
  return Ok ( value : Config { addr : addr mode : nil } )
}

fn main() -> i32 !env !io {
  let cfg = load ( ) ?
  println ( value : "${cfg.addr}" )
  return 0
}

mod main

import http
import json

type Msg {
  text:str
}

fn handler(req:http.Req) -> R[http.Resp,str] {
  let _ = req
  let body = Msg { text : "ok" }
  return Ok ( value : http.json ( code : 200 , body : json.encode ( value : body ) ? ) )
}

fn main() -> i32 !net {
  http.serve ( addr : ":8080" , handler : handler ) ?
  return 0
}

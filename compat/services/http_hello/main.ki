mod main

import http

fn handler(req:http.Req) -> R[http.Resp,str] {
  when (req.path) {
  "/" => {
  return Ok ( value : http.text ( code : 200 , body : "hello" ) )
  }
  _ => {
  return Ok ( value : http.not_found ( ) )
  }
  }
}

fn main() -> R[i32,str] !net {
  http.serve ( addr : ":8080" , handler : handler ) ?
  return Ok ( value : 0 )
}

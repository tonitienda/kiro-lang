mod main

import parse

type User {
  id:i32
  email:?str
}

fn parse_id(raw:str) -> R[i32,str] {
  return parse.i32 ( text : raw )
}

fn maybe_email(id:i32) -> ?str {
  when ( id ) {
  1 => { return "ops@kiro.dev" }
  _ => { return nil }
  }
}

fn load_user(raw:str) -> R[User,str] {
  let id = parse_id ( raw : raw ) ?
  return Ok ( value : User { id : id email : maybe_email ( id : id ) } )
}

mod main

import http
import log

type App {
  port:str
}

fn handler(req:http.Req) -> R[http.Resp, str] {
  when (req.path) {
    "/health" => {
      return Ok(value : http.text(code : 200, body : "ok"))
    }
    _ => {
      return Ok(value : http.not_found())
    }
  }
}

fn main() -> i32 !log !net {
  let app = App{port:":8080"}
  log.info(message : "starting ${app.port}")
  http.serve(addr : app.port, handler : handler)?
  return 0
}
